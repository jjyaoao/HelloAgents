# ============================================================================
# HelloAgents 环境变量配置示例
# ============================================================================
# 复制此文件为 .env，按所需功能填写配置。
# 推荐 Python 3.13；支持 Python 3.12 / 3.13。
# 示例会加载 .env；自行编写程序时，先调用 load_dotenv()。

# ============================================================================
# 🚀 聊天模型配置
# ============================================================================
# 使用真实模型运行 Agent 时填写；离线示例、仅云端检索的示例无需填写。
# 模型名称与服务地址请以所选服务商的 API 文档为准。

# 模型名称
LLM_MODEL_ID=your-model-name

# API 密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 请求超时时间（单位：秒；默认 60）
LLM_TIMEOUT=60

# ============================================================================
# 🛠️ 搜索工具配置（可选）
# ============================================================================

# Tavily 搜索：注册并获取 API 密钥 https://tavily.com/
# TAVILY_API_KEY=your_tavily_key_here

# SerpApi 搜索：注册并获取 API 密钥 https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

# ============================================================================
# ☁️ Qdrant 云端检索配置（RAG / Memory，可选）
# ============================================================================
# 注册地址：https://cloud.qdrant.io/
# 创建集群后，从控制台复制集群 Endpoint 和 API Key。
# 完整步骤见 docs/cloud-retrieval-guide.md。

# 集群地址（Endpoint）
QDRANT_URL=

# 集群 API 密钥
QDRANT_API_KEY=

# 云端嵌入模型（默认使用以下多语言模型，无需下载本地模型）
QDRANT_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# 嵌入向量维度，必须与上面的模型匹配
QDRANT_EMBEDDING_DIMENSION=384

# 存储向量的集合名称；更换嵌入模型或维度时，请使用新集合
QDRANT_COLLECTION=hello_agents_cloud

# ============================================================================
# 🧩 独立嵌入服务配置（可选，替代云端嵌入）
# ============================================================================
# 使用 OpenAI 兼容的 Embeddings 接口时填写。
# 使用上面的 Qdrant 云端嵌入时，无需填写本节。
# 模型与维度请查询嵌入服务商文档；使用方法见 docs/qdrant_retrieval.md。

# 嵌入服务 API 密钥
# EMBEDDING_API_KEY=

# 嵌入服务地址
# EMBEDDING_BASE_URL=

# 嵌入模型名称
# EMBEDDING_MODEL=

# 嵌入向量维度
# EMBEDDING_DIMENSION=
